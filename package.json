{
  "name": "security-partners",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "tsx:server": "tsx --env-file-if-exists=.env.development --import ./scripts/register-server-only.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "NODE_OPTIONS='--import ./scripts/register-server-only.mjs' drizzle-kit generate",
    "db:migrate": "pnpm tsx:server scripts/migrate.ts",
    "scripts:build": "tsx scripts/build-scripts.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "2.1.2",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "hono": "4.13.13",
    "lenis": "1.3.26",
    "lucide-react": "^1.54.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.2",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
