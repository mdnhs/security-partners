{
  "name": "security-partners",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "tsx:server": "tsx --env-file-if-exists=.env.development --import ./scripts/register-server-only.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "NODE_OPTIONS='--import ./scripts/register-server-only.mjs' drizzle-kit generate",
    "db:migrate": "pnpm tsx:server scripts/migrate.ts",
    "scripts:build": "tsx scripts/build-scripts.ts",
    "test:e2e": "playwright test tests/e2e",
    "admin:create": "pnpm tsx:server scripts/admin-create.ts",
    "owner:recover": "pnpm tsx:server scripts/owner-recover.ts",
    "demo:seed": "pnpm tsx:server scripts/demo-seed.ts",
    "db:seed": "pnpm tsx:server scripts/seed.ts",
    "backup": "pnpm tsx:server scripts/backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@gsap/react": "2.1.2",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "hono": "4.13.13",
    "jsdom": "30.1.3",
    "lenis": "1.3.26",
    "lucide-react": "^1.54.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.2",
    "react-hook-form": "7.90.0",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "otpauth": "9.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "2.1.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
